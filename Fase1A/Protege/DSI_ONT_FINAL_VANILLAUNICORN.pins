; Sat Nov 08 19:19:35 CET 2025
; 
;+ (version "3.4.8")
;+ (build "Build 629")

([bradicardia_ejem] of  Bradicardia

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Frecuencia cardiaca de 50 ppm (menor que 60 ppm)"))

([ciclo1] of  Ciclo

	(numeroCiclo 1))

([ComplejoQRS] of  %3ASTANDARD-CLASS

	(%3ASLOT-CONSTRAINTS [DSI_ONT_FINAL_VANILLAUNICORN_Class0]))

([complejoQRS1] of  ComplejoQRS

	(amplitudMaxima 1.25)
	(compuestoPor
		[ondaQ1]
		[ondaR1]
		[ondaS1])
	(duracion 100)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1370)
	(tiempoInicio 1220))

([cvp_ejem] of  ContraccionVentricularPrematura

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Complejo QRS ancho (mayor de 120 ms) y prematuro"))

([DSI_ONT_FINAL_VANILLAUNICORN_Class0] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Debe estar compuesto por ondas Q, R y S.")
	(%3APAL-NAME "Compuesto")
	(%3APAL-STATEMENT "(Predicate)"))

([DSI_ONT_FINAL_VANILLAUNICORN_Class1] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Debe tener al menos un ciclo cardiaco.")
	(%3APAL-NAME "paciente"))

([DSI_ONT_FINAL_VANILLAUNICORN_Class2] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "La amplitud debe ser positiva (mayor que 0).")
	(%3APAL-NAME "amplitud"))

([hipocalcemia_ejem] of  Hipocalcemia

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Intervalo QT prolongado (mayor de 440 ms)"))

([hipopotasemia_ejem] of  Hipopotasemia

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Onda T aplanada y presencia de onda U prominente"))

([infAguMiocardio_ejem] of  InfartoAgudoMiocardio

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Elevacion del segmento ST mayor de 0.1 mV"))

([intervaloPR1] of  IntervaloPR

	(amplitudMaxima 0.25)
	(compuestoPor
		[ondaP1]
		[ondaR1])
	(duracion 160)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1270)
	(tiempoInicio 1000))

([intervaloQT1] of  IntervaloQT

	(amplitudMaxima 0.25)
	(compuestoPor
		[ondaQ1]
		[ondaT1])
	(duracion 390)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1610)
	(tiempoInicio 1220))

([intervaloRR1] of  IntervaloRR

	(amplitudMaxima 1.25)
	(compuestoPor
		[ondaR1]
		[ondaR1])
	(duracion 900)
	(perteneceACiclo [ciclo1])
	(tiempoFin 2140)
	(tiempoInicio 1240))

([isqCoronaria_ejem] of  IsquemiaCoronaria

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Depresion del segmento ST e inversion de onda T"))

([normal_ejem] of  Normal

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Frecuencia cardiaca de 85 ppm"))

([ondaP1] of  OndaP

	(amplitudMaxima 0.25)
	(duracion 80)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1080)
	(tiempoInicio 1000))

([ondaQ1] of  OndaQ

	(amplitudMaxima -0.5)
	(duracion 100)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1220)
	(tiempoInicio 1120))

([OndaR] of  %3ASTANDARD-CLASS

	(%3ASLOT-CONSTRAINTS [DSI_ONT_FINAL_VANILLAUNICORN_Class2]))

([ondaR1] of  OndaR

	(amplitudMaxima 1.25)
	(duracion 50)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1270)
	(tiempoInicio 1220))

([ondaS1] of  OndaS

	(amplitudMaxima -0.75)
	(duracion 100)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1370)
	(tiempoInicio 1270))

([ondaT1] of  OndaT

	(amplitudMaxima 0.25)
	(duracion 160)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1610)
	(tiempoInicio 1450))

([RegistroECG] of  %3ASTANDARD-CLASS

	(%3ASLOT-CONSTRAINTS [DSI_ONT_FINAL_VANILLAUNICORN_Class1]))

([registroECG1] of  RegistroECG

	(frecuenciaCardiaca 145)
	(tieneCiclo [ciclo1])
	(tieneComponente
		[ondaP1]
		[ondaQ1]
		[ondaR1]
		[ondaS1]
		[ondaT1]
		[complejoQRS1])
	(tieneDiagnostico [taquicardia_ejem])
	(totalCiclos 50))

([segmentoPQ1] of  SegmentoPQ

	(amplitudMaxima 0.0)
	(compuestoPor
		[ondaP1]
		[ondaQ1])
	(duracion 40)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1120)
	(tiempoInicio 1080))

([segmentoST1] of  SegmentoST

	(amplitudMaxima 0.0)
	(compuestoPor
		[ondaS1]
		[ondaT1])
	(duracion 80)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1450)
	(tiempoInicio 1370))

([segmentoTP] of  SegmentoTP

	(amplitudMaxima 0.0)
	(compuestoPor
		[ondaT1]
		[ondaP1])
	(duracion 320)
	(perteneceACiclo [ciclo1])
	(tiempoFin 1910)
	(tiempoInicio 1610))

([taquicardia_ejem] of  Taquicardia

	(detectadoEn [ciclo1])
	(motivoDiagnostico "Frecuencia cardiaca de 145 ppm (mayor que 100 ppm)"))
